// Cloudflare Workers settings for worldmap.tech.
// The site is prebuilt into site/ by `node build.js`; Cloudflare only runs `npx wrangler deploy`.
{
  "name": "worldmap",
  "main": "server/_worker.js",
  "compatibility_date": "2026-09-01",

  // static files; only /api/* runs the Worker (restore codes)
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // restore-code database; created automatically on the first deploy, then reused by name
  "d1_databases": [
    { "binding": "DB", "database_name": "worldmap" }
  ],

  // no request logs: the privacy policy says we keep no IP addresses
  "observability": { "enabled": false },

  // worldmap.<account>.workers.dev for testing; branch builds get preview URLs
  "workers_dev": true,
  "preview_urls": true
}
