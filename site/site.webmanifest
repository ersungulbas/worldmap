{
  "name": "worldmap.tech",
  "short_name": "worldmap",
  "description": "Tap the countries you've visited, see how much of the world you've seen and your traveller level, then save a shareable image or compare maps with friends.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e9f0f6",
  "theme_color": "#2f7ee0",
